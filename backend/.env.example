# ===== LLM 配置 =====
# DeepSeek 是 OpenAI 兼容协议，开发期用它跑通流程
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 可选：运行指标里的费用估算。按模型填写实际每百万 token 单价（USD）；不填则费用显示未知。
# SAGE_LLM_PRICES_JSON={"deepseek-flash":{"input_per_million":0,"output_per_million":0}}
AUTH_SECRET=replace-with-a-random-secret
# 生产环境请使用至少 32 字符的随机密钥；账号均需显式初始化。

# ===== Embedding 配置 =====
# DeepSeek 不提供 embedding；留空时 SAGE 使用本地关键词检索。
# 可选择 openai-compatible、local，或 remote_http（现有 /embed 协议）。
# remote_http 经 SSH 本地转发：EMBEDDING_PROVIDER=remote_http，
# EMBEDDING_BASE_URL=http://127.0.0.1:18081；先启动隧道再启动后端。
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# RAG / ChromaDB
RAG_BACKEND=chroma
RAG_CHROMA_PATH=data/chroma
RAG_COLLECTION=sage_knowledge
RAG_MODEL_DEVICE=cpu
RAG_EMBED_BATCH_SIZE=16
# 重排评测未证明收益，默认关闭；需显式开启并配置 /rerank 服务。
RAG_RERANKER_ENABLED=false
RAG_RERANKER_PROVIDER=local
RAG_RERANKER_BASE_URL=
RAG_RERANKER_BATCH_SIZE=2
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RETRIEVE_K=12
RAG_RERANK_K=5

# ===== 数据库 =====
# 默认 backend/sage.db；测试时可指定独立 SQLite 文件。
# SAGE_DATABASE_URL=sqlite:///D:/path/to/sage.db

# ===== 应用配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# production 默认关闭自助注册；仅在确有公开注册需求时显式开启。
PUBLIC_REGISTRATION=false
# 原始 Prompt/回复可能含个人答案，仅本地调试时临时开启。
LLM_DEBUG=0
