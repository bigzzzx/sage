# ===== LLM 配置 =====
# DeepSeek 是 OpenAI 兼容协议，开发期用它跑通流程
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
AUTH_SECRET=replace-with-a-random-secret

# ===== Embedding 配置 =====
# DeepSeek 不提供 embedding；留空时 SAGE 使用本地关键词检索。
# 接入任意 OpenAI 兼容 embedding 服务后，会自动启用“向量 + 关键词”混合检索。
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# RAG / ChromaDB
RAG_BACKEND=chroma
RAG_CHROMA_PATH=data/chroma
RAG_COLLECTION=sage_knowledge
RAG_MODEL_DEVICE=cpu
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RETRIEVE_K=12
RAG_RERANK_K=5

# ===== 数据库（后续启用） =====
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage

# ===== 应用配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
