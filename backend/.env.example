# ===== LLM 配置 =====
# DeepSeek 是 OpenAI 兼容协议，开发期用它跑通流程
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding 配置 =====
# 开发期可以先用 DeepSeek 暂不支持 embedding，后续接入 BGE 或通义
# 暂留空，先把 LLM 这条线跑通
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ===== 数据库（后续启用） =====
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage

# ===== 应用配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
